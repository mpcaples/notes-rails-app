<%= form_with model: note do |form| %>
  <% if form.object.errors.any? %>
    <p class="error"><%= form.object.errors.full_messages.first %></p>
  <% end %>

  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>

    <%= form.label :body %>
    <%= form.text_area :body %>
  </div>

  <%= form.label :new_tag_name, "Add a tag" %>
  <%= form.text_field :new_tag_name, placeholder: "Add a tag..." %>

  <div>
    <%= form.submit %>
  </div>
<% end %>
